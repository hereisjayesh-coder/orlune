<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissions are added phase-by-phase, only when a real feature needs them,
        never speculatively (Section 10, Privacy Architecture). Still true: no
        INTERNET permission exists anywhere in this file, and never will for the
        core product — zero outbound network requests is architectural, not just
        policy.

        PACKAGE_USAGE_STATS (Phase 3, Usage Access) cannot actually be granted via
        this manifest declaration — its real gate is an AppOpsManager check
        (UsageAccessPermission.kt), granted by the user manually in Settings. The
        declaration is still required: several OEM Settings implementations only
        list apps for the Usage Access toggle if they declare it here.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Scoped package visibility for app-label lookups (Phase 3) — deliberately
        NOT QUERY_ALL_PACKAGES (Play-gated, Section 12.3). PACKAGE_USAGE_STATS does
        not itself grant package visibility; this is what makes ordinary launchable
        apps (the overwhelming majority of what shows up in usage events) resolvable
        via PackageManager. Apps with no launcher activity fall back to their raw
        package name (AppLabelResolver.kt) rather than crashing.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
            A launcher/home-replacement app's own activity is registered under
            CATEGORY_HOME, not CATEGORY_LAUNCHER (Android's documented distinction
            between "shows up in the app drawer" and "is a home screen the user can
            set as default"). Without this, PackageManager.getApplicationInfo() for
            the device's current default launcher throws NameNotFoundException, and
            AppLabelResolver/InstalledAppLister fall back to showing its raw package
            name (e.g. "com.google.android.apps.nexuslauncher") in usage lists —
            still scoped/minimal, not QUERY_ALL_PACKAGES (see
            docs/app-visibility-compliance.md).
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!--
        Phase 5 (App blocking). SYSTEM_ALERT_WINDOW is the platform's documented
        mechanism for a blocking UI without AccessibilityService (Section 9) — like
        PACKAGE_USAGE_STATS, it's a special permission the user grants manually in
        Settings, not via a runtime dialog. FOREGROUND_SERVICE was already present
        transitively via WorkManager (Phase 3); declared explicitly now that Phase 5
        directly depends on it for BlockingMonitorService.
        FOREGROUND_SERVICE_SPECIAL_USE + the specialUse type below are required by
        Android 14+ for a foreground service that doesn't fit a more specific type.
        POST_NOTIFICATIONS is requested for UX only — the foreground service still
        runs and enforces rules even if this is denied, it just won't show its
        persistent notification.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OrluneApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Orlune"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Orlune">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            OrluneApplication supplies its own WorkManager Configuration (a custom
            WorkerFactory so UsageAggregationWorker can be constructor-injected with
            UsageRepository) — this disables WorkManager's default auto-initializer,
            which would otherwise conflict with that custom configuration.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Phase 5. specialUse is the closest-fitting Android 14+ foreground service
            type for app-blocking enforcement — no more specific type (dataSync,
            location, etc.) applies. The property value is a free-form, non-enumerated
            description of the use case, per Android's own specialUse documentation.
        -->
        <service
            android:name=".platform.blocking.BlockingMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app_blocking" />
        </service>

    </application>

</manifest>
