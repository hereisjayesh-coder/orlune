<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Manifest-level theme: only governs the instant before setContent{} composes
         and system-chrome defaults. Deliberately always black (not day/night-aware) —
         Orlune is black-first by brand, so the pre-Compose flash should read as
         Orlune's black, not the framework's default white. Real System/Light/Dark
         theming is entirely Compose-driven via OrluneTheme (see ui/theme/Theme.kt). -->
    <style name="Theme.Orlune" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
