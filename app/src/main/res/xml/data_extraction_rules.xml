<?xml version="1.0" encoding="utf-8"?>
<!--
    Local-only privacy promise (Section 10): no cloud backup, no device-transfer
    of app data. Both cloud-backup and device-transfer rules deliberately exclude
    all data by omitting any <include> entries.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
